# ─────────────────────────────────────────────────────────────
#  Petit Atelier des Jeux — configuration
#  En local : copiez ce fichier en « .env ».
#  En ligne : saisissez les mêmes variables dans Vercel
#  (Project → Settings → Environment Variables). Voir docs/MISE-EN-PRODUCTION.md.
#  Ne mettez JAMAIS le fichier .env sur GitHub : il contient des secrets.
# ─────────────────────────────────────────────────────────────

# development en local, production en ligne
NODE_ENV=development
PORT=8787

# Adresse publique du site (sans / final). En local avec « npm run dev » : http://localhost:5173
# En ligne : https://petit-atelier-des-jeux.vercel.app
URL_PUBLIQUE=http://localhost:5173

# Secret qui signe les liens de téléchargement (64 caractères aléatoires, obligatoire en production).
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_LIENS=

# ── Base de données des commandes ─────────────────────────────
# En local, laissez vide : les commandes sont enregistrées dans data/boutique.sqlite.
# En ligne (obligatoire) : adresse et jeton de la base Turso (libsql://….turso.io).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Paiement ──────────────────────────────────────────────────
# desactive  : le bouton de paiement est inactif (valeur par défaut)
# simulation : faux paiement pour tester en local (interdit en production)
# stripe     : vrai Stripe Checkout (clés de TEST sk_test_ pour commencer, LIVE sk_live_ uniquement en production)
PAIEMENT_MODE=simulation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true pour autoriser les codes promo créés dans votre tableau de bord Stripe
STRIPE_CODES_PROMO=false

# ── E-mails (Gmail de l'atelier) ──────────────────────────────
# Sans SMTP_HOST, en local, les e-mails sont écrits dans data/boite-envoi/ au lieu d'être envoyés.
# Gmail : SMTP_PASS est un « mot de passe d'application » de 16 lettres (pas le mot de passe du compte).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR="Petit Atelier des Jeux <contact.petitatelierdesjeux@gmail.com>"
# Adresse qui reçoit les messages du formulaire de contact
EMAIL_BOUTIQUE=contact.petitatelierdesjeux@gmail.com

# ── Durées d'accès ────────────────────────────────────────────
# Validité d'un bouton de téléchargement (heures) et du lien de commande envoyé par e-mail (jours)
DUREE_LIEN_TELECHARGEMENT_HEURES=24
DUREE_ACCES_COMMANDE_JOURS=30

# ── Dossiers (valeurs par défaut conseillées) ─────────────────
DOSSIER_DONNEES=data
DOSSIER_FICHIERS=storage
FICHIER_CATALOGUE=catalogue/catalogue.json

# ── Vercel uniquement (à saisir dans Vercel, inutile en local) ─
# NODEJS_HELPERS=0   indispensable pour que les paiements Stripe soient confirmés
